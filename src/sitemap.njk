<url><loc>{{ site.origin }}/contact/</loc></url>
{% for s in states %}<url><loc>{{ site.origin }}/{{ s.slug }}/</loc></url>
{% endfor %}{% for c in cityPages %}<url><loc>{{ site.origin }}/{{ c.stateSlug }}/{{ c.slug }}/</loc></url>
{% endfor %}</urlset>
